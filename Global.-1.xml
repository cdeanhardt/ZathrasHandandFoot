<!-- Xml UI. See documentation: https://api.tabletopsimulator.com/ui/introUI/ -->
<Defaults>
  <Panel class="WindowBorder" color="#8F8478" outline="#635351" outlineSize="2 -2" />
  <Panel class="SubPanel" color="#8F8478" outline="#635351" outlineSize="2 -2" />
    <Row class="MenuBar" color="#FFFFFF" />
    <Button class="topButtons" width="25" height="25" rectAlignment="UpperLeft" color="#eeeeee" offsetXY="-3 -3" />
    <Button class="recButton" width="65" height="25" rectAlignment="UpperLeft" color="#eeeeee" offsetXY="-375 -3" />
    <Text class="UIText" fontSize="18" fontStyle="Normal" color="#000000" />
    <TableLayout class="ScoreTable" width="440" columnWidths="0 50 50 50 50 60" height="150" rectAlignment="UpperRight" offsetXY="-5 -10" cellPadding="5" color="#FFFFFF" />
    <Cell class="cell" />
    <Row class="ScoreTableRow" preferredHeight="30" />
    <InputField class="UIInputField" width="50" height="50" fontSize="14" fontStyle="Bold" colors="#FFFFFF|#dddddd|#FFFFFF|rgba(0.78,0.78,0.78,0.5)" />
    <Button class="PMButton" width="10" height="10" rectAlignment="MiddleCenter" color="rgba(1,1,1,0)" />
    <Button class="FAB" height="30" width="50" color="rgba(1,1,1,0)" />
</Defaults>
<Panel id="ScoreSheetPanel" class="WindowBorder" width="450" height="30" rectAlignment="UpperRight" showAnimation="Grow" hideAnimation="Shrink" returnToOriginalPositionWhenReleased="false" allowDragging="true" color="#bbbbbb00">
    <Row id="MenuBar" class="MenuBar" width="450">
        <Text id="WindowTitle" text="Score Sheet" class="UIText" rectAlignment="UpperCenter" alignment="LowerCenter" width="230" height="80" offsetXY="0 55" />
        <Button id="recordButton" class="recButton" rectAlignment="UpperRight" color="#990000" textColor="#FFFFFF" text="Record" onClick="recordScores" />
        <Button id="closeButton" class="topButtons" rectAlignment="UpperRight" color="#990000" textColor="#FFFFFF" text="^" onClick="ClosePanel" />
    </Row>
    <Panel id="SubPanel" class="SubPanel" width="450" height="175" rectAlignment="UpperRight" showAnimation="Grow" hideAnimation="Shrink" returnToOriginalPositionWhenReleased="false" xallowDragging="true" color="#bbbbbb" offsetXY="0 -30">
      <TableLayout id="ScoreTable" class="ScoreTable" >
          <Row class="ScoreTableRow" dontUseTableRowBackground="true" color="#0089EA">
            <Cell class="cell">
                <Text id="Plyr" text="Player" />
            </Cell>
            <Cell>
                <Text id="R1" text="1" />
            </Cell>
            <Cell>
                <Text id="R2" text="2" />
            </Cell>
            <Cell>
                <Text id="R3" text="3" />
            </Cell>
            <Cell>
                <Text id="R4" text="4" />
            </Cell>
            <Cell>
                <Text id="TOTAL" text="Total" />
            </Cell>
          </Row>
          <Row id="ScoreRow1" class="ScoreTableRow">
              <Cell>
                  <Text id="Player1" text="Player 1"></Text>
              </Cell>
              <Cell>
                  <Text id="P1R1Score"></Text>
              </Cell>
              <Cell>
                  <Text id="P1R2Score"></Text>
              </Cell>
              <Cell>
                  <Text id="P1R3Score"></Text>
              </Cell>
              <Cell>
                  <Text id="P1R4Score"></Text>
              </Cell>
              <Cell>
                  <Text id="P1R5Score"></Text>
              </Cell>
          </Row>
          <Row id="ScoreRow2" class="ScoreTableRow">
              <Cell>
                  <Text id="Player2" text="Player 2"></Text>
              </Cell>
              <Cell>
                  <Text id="P2R1Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P2R2Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P2R3Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P2R4Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P2R5Score"> </Text>
              </Cell>
          </Row>
          <Row id="ScoreRow3" class="ScoreTableRow">
              <Cell>
                  <Text id="Player3" text="Player 3"></Text>
              </Cell>
              <Cell>
                  <Text id="P3R1Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P3R2Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P3R3Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P3R4Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P3R5Score"> </Text>
              </Cell>
          </Row>
          <Row id="ScoreRow4" class="ScoreTableRow">
              <Cell>
                  <Text id="Player4" text="Player 4">Player 4</Text>
              </Cell>
              <Cell>
                  <Text id="P4R1Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P4R2Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P4R3Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P4R4Score"> </Text>
              </Cell>
              <Cell>
                  <Text id="P4R5Score"> </Text>
              </Cell>
          </Row>
      </TableLayout>
      <Image id="GoesFirst" active="false" image="GoesFirstOrangeBorder" height="25" width="25" rectAlignment="UpperLeft" offsetXY="-5 0" />
    </Panel>
</Panel>

<!-- ============================================================ -->
<!-- Action Panel — floating window for hand action buttons.      -->
<!-- Visible to White only; expand visibility list as needed.     -->
<!-- ============================================================ -->
<Panel id="ActionPanel"
       width="190" height="30"
       rectAlignment="MiddleLeft" offsetXY="10 0"
       showAnimation="Grow" hideAnimation="Shrink"
       returnToOriginalPositionWhenReleased="false" allowDragging="true"
       color="#bbbbbb00"
       visibility="White">
    <Row id="ActionMenuBar" class="MenuBar" width="190">
        <Text id="ActionWindowTitle" text="Hand Actions" class="UIText"
              rectAlignment="UpperCenter" alignment="LowerCenter"
              width="140" height="80" offsetXY="0 55" />
        <Button id="ActionCloseButton" class="topButtons"
                rectAlignment="UpperRight" color="#990000"
                textColor="#FFFFFF" text="^"
                onClick="click_ToggleActionPanel" />
    </Row>
    <!-- Collapsed height=230; expanded height=415 (set dynamically by click_ToggleActionExpanded) -->
    <Panel id="ActionSubPanel" class="SubPanel"
           width="190" height="230"
           rectAlignment="UpperLeft" offsetXY="0 -30"
           color="#bbbbbb">
        <!-- ── Always-visible buttons ── -->
        <Button id="btnToggleActionExpanded"
                text="▼ More" width="174" height="20"
                rectAlignment="UpperCenter" offsetXY="0 -5"
                color="#444444" textColor="#FFFFFF" fontSize="11"
                onClick="click_ToggleActionExpanded" />
        <Button id="btnDraw"
                text="Draw" width="174" height="30"
                rectAlignment="UpperCenter" offsetXY="0 -30"
                color="#556644" textColor="#FFFFFF" fontSize="14"
                onClick="click_ActionDraw" />
        <Button id="btnPlan"
                text="Plan" width="174" height="30"
                rectAlignment="UpperCenter" offsetXY="0 -65"
                color="#445566" textColor="#FFFFFF" fontSize="14"
                onClick="click_ActionPlan" />
        <Toggle id="toggleAutodraw"
                text=" Autodraw"
                isOn="false"
                onValueChanged="click_ToggleAutodraw"
                width="174" height="25"
                rectAlignment="UpperCenter" offsetXY="0 -100"
                fontSize="12" textColor="#000000"
                toggleWidth="18" toggleHeight="18" />
        <Toggle id="toggleAutoExec"
                text=" Auto Exec"
                isOn="false"
                onValueChanged="click_ToggleAutoExec"
                width="174" height="25"
                rectAlignment="UpperCenter" offsetXY="0 -130"
                fontSize="12" textColor="#000000"
                toggleWidth="18" toggleHeight="18" />
        <Toggle id="toggleEnhance"
                text=" Enhance"
                isOn="true"
                onValueChanged="click_ToggleEnhance"
                width="174" height="25"
                rectAlignment="UpperCenter" offsetXY="0 -160"
                fontSize="12" textColor="#000000"
                toggleWidth="18" toggleHeight="18" />
        <Button id="btnFixPlanPanel"
                text="Fix Plan Panel" width="174" height="25"
                rectAlignment="UpperCenter" offsetXY="0 -190"
                color="#554444" textColor="#FFFFFF" fontSize="11"
                onClick="click_FixPlanPanel" />
        <!-- ── Expandable buttons (hidden by default) ── -->
        <Button id="btnPlayHand"
                text="Play Hand" width="174" height="30"
                rectAlignment="UpperCenter" offsetXY="0 -230"
                color="#2255aa" textColor="#FFFFFF" fontSize="14"
                active="false"
                onClick="click_ActionPlayHand" />
        <Button id="btnLayoutAllHand"
                text="Layout All Hand" width="174" height="30"
                rectAlignment="UpperCenter" offsetXY="0 -265"
                color="#2255aa" textColor="#FFFFFF" fontSize="14"
                active="false"
                onClick="click_ActionLayoutAllHand" />
        <Button id="btnPlayAndLay"
                text="Play and Lay" width="174" height="30"
                rectAlignment="UpperCenter" offsetXY="0 -300"
                color="#226622" textColor="#FFFFFF" fontSize="14"
                active="false"
                onClick="click_ActionPlayAndLay" />
        <Button id="btnDrawSortPlayLay"
                text="Draw, Sort, Play Lay" width="174" height="30"
                rectAlignment="UpperCenter" offsetXY="0 -335"
                color="#664422" textColor="#FFFFFF" fontSize="14"
                active="false"
                onClick="click_ActionDrawSortPlayLay" />
        <Button id="btnDiscard"
                text="Discard" width="174" height="30"
                rectAlignment="UpperCenter" offsetXY="0 -370"
                color="#882222" textColor="#FFFFFF" fontSize="14"
                active="false"
                onClick="click_ActionDiscard" />
        <!-- Build stamp. Bumped by Claude on each requested change. -->
        <Text id="ActionVersionStamp" text="v10"
              width="180" height="16"
              rectAlignment="LowerCenter" offsetXY="0 3"
              fontSize="12" color="#444444" alignment="MiddleCenter" />
    </Panel>
</Panel>

<!-- ============================================================ -->
<!-- Plan Result Panel — popup showing the turn plan.             -->
<!-- Shown/hidden by click_ActionPlan / click_PlanClose.          -->
<!-- ============================================================ -->
<Panel id="PlanResultPanel" active="false"
       width="420" height="30"
       rectAlignment="MiddleCenter"
       returnToOriginalPositionWhenReleased="false" allowDragging="true"
       color="#bbbbbb00"
       visibility="White">
    <Row id="PlanResultMenuBar" class="MenuBar" width="420">
        <Text id="PlanResultTitle" text="Turn Plan" class="UIText"
              rectAlignment="UpperCenter" alignment="LowerCenter"
              width="350" height="80" offsetXY="0 55" />
        <Button id="PlanResultCloseButton" class="topButtons"
                rectAlignment="UpperRight" color="#990000"
                textColor="#FFFFFF" text="^"
                onClick="click_PlanClose" />
    </Row>
    <Panel id="PlanResultSubPanel" class="SubPanel"
           width="420" height="420"
           rectAlignment="UpperLeft" offsetXY="0 -30"
           color="#bbbbbb">
        <!-- Plan history nav: 1=most recent, 5=oldest -->
        <Button id="btnPlanH1" active="false" text="1" width="20" height="16"
                rectAlignment="UpperLeft" offsetXY="8 -8"
                color="rgba(0,0,0,0)" textColor="#777777" fontSize="11"
                onClick="click_PlanNav" />
        <Button id="btnPlanH2" active="false" text="2" width="20" height="16"
                rectAlignment="UpperLeft" offsetXY="30 -8"
                color="rgba(0,0,0,0)" textColor="#777777" fontSize="11"
                onClick="click_PlanNav" />
        <Button id="btnPlanH3" active="false" text="3" width="20" height="16"
                rectAlignment="UpperLeft" offsetXY="52 -8"
                color="rgba(0,0,0,0)" textColor="#777777" fontSize="11"
                onClick="click_PlanNav" />
        <Button id="btnPlanH4" active="false" text="4" width="20" height="16"
                rectAlignment="UpperLeft" offsetXY="74 -8"
                color="rgba(0,0,0,0)" textColor="#777777" fontSize="11"
                onClick="click_PlanNav" />
        <Button id="btnPlanH5" active="false" text="5" width="20" height="16"
                rectAlignment="UpperLeft" offsetXY="96 -8"
                color="rgba(0,0,0,0)" textColor="#777777" fontSize="11"
                onClick="click_PlanNav" />
        <InputField id="PlanResultText"
                    text=""
                    fontSize="12"
                    lineType="MultiLineNewline"
                    interactable="true"
                    readOnly="true"
                    width="404" height="265"
                    rectAlignment="UpperCenter" offsetXY="0 -30"
                    colors="#FFFFFF|#FFFFFF|#FFFFFF|#FFFFFF"
                    textColor="#000000" />
        <!-- Auto-exec countdown progress bar -->
        <Panel id="progressBarBg"
               width="404" height="16"
               rectAlignment="LowerCenter" offsetXY="0 96"
               color="#444444">
            <Panel id="progressBarFill"
                   width="0" height="16"
                   rectAlignment="MiddleLeft"
                   color="#22aa44" />
        </Panel>
        <!-- Stop timer button -->
        <Button id="btnPlanStop"
                text="Stop Timer" width="404" height="30"
                rectAlignment="LowerCenter" offsetXY="0 58"
                color="#886600" textColor="#FFFFFF" fontSize="14"
                onClick="click_PlanStop" />
        <!-- Bottom row: Close / Copy / Execute -->
        <Button id="btnPlanClose"
                text="Close" width="126" height="30"
                rectAlignment="LowerLeft" offsetXY="8 8"
                color="#990000" textColor="#FFFFFF" fontSize="14"
                onClick="click_PlanClose" />
        <Button id="btnPlanCopy"
                text="Copy to Chat" width="126" height="30"
                rectAlignment="LowerCenter" offsetXY="0 8"
                color="#445566" textColor="#FFFFFF" fontSize="14"
                onClick="click_PlanCopy" />
        <Button id="btnPlanExecute"
                text="Execute" width="126" height="30"
                rectAlignment="LowerRight" offsetXY="-8 8"
                color="#226622" textColor="#FFFFFF" fontSize="14"
                onClick="click_PlanExecute" />
    </Panel>
</Panel>